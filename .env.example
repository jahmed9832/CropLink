# Environment: development | production | test
ENVIRONMENT=development

# Render e Environment tab-e eigulo set korbe
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=agrisphere
# optional: app theke asha request protect korte (app e header: X-API-Key)
API_KEY=
ALLOWED_ORIGINS=*

# login token sign korar secret (Render auto-generate kore, minimum 32 characters in production)
JWT_SECRET=dev-only-change-me-replace-with-a-very-long-secret-key-32-chars
AUTH_REQUIRED=true

# optional: weather API (openweathermap.org free key). Na dile temperature default 30C / user input
OPENWEATHER_API_KEY=

# optional: Google Gemini API key and model for AI assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# demo account + sample data (frontend team-er jonno). Production-e false
SEED_DEMO=false
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=

# Synthetic price data permission
ALLOW_SYNTHETIC_DATA=false

# optional: nijer admin account
ADMIN_PHONE=
ADMIN_PASSWORD=

# optional: default response language (bn | en). Request header Accept-Language diye bodlano jay
DEFAULT_LANG=bn
